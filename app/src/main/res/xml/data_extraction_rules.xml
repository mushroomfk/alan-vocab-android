<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 标准云备份 25MB，不包含含词库的数据库。设置单独备份；学习记录用应用内导出。 -->
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
        <exclude domain="sharedpref" path="alan_secure_session.xml" />
        <exclude domain="sharedpref" path="alan_device.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
        <exclude domain="sharedpref" path="alan_secure_session.xml" />
        <exclude domain="sharedpref" path="alan_device.xml" />
    </device-transfer>
</data-extraction-rules>
